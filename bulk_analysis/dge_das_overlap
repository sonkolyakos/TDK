  write.csv(dge[[cell]][[cmp]], sprintf("DGE_%s_%s.csv", cell, cmp), row.names = FALSE)

cat("\nDGE szignifikáns gének (padj <", DGE_PADJ, ", |log2FC| >", DGE_LFC, "):\n")
print(sapply(dge, function(x) sapply(x, function(d) sum(d$DGE_sig))))
cat("\nDGE szignifikáns gének (csak padj <", DGE_PADJ, "):\n")
print(sapply(dge, function(x) sapply(x, function(d) sum(d$padj_sig))))
cat("\nTesztelt gének (padj nem NA):\n")
print(sapply(dge, function(x) sapply(x, function(d) sum(!is.na(d$padj)))))
