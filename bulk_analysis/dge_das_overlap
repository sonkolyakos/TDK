## 6.7 Egy gén normalizált expressziója

Sejtvonalanként egy oszlopdiagram: az **első oszlop** a CTR és a TIS átlagos normalizált értékének összege
(mekkora a gén teljes jelenléte a két állapotban), a **második és harmadik oszlop** a CTR, illetve a TIS átlaga ± SD
(a pontok az egyes minták). A panelcím a gén `CTR_vs_TIS` DGE eredményét is mutatja (log2FC iránya: TIS − CTR).
A normalizálás a DESeq2 size factoraival történik. A gént szimbólummal vagy Ensembl ID-val is meg lehet adni;
ha egy szimbólumhoz több ID tartozik, a legerősebben expresszált ID szerepel az ábrán és az annotációban is.

```{r gene_expr_plot}
gene_expr_plot <- function(gene, conds = c("CTR", "TIS"), 
                           out_dir = "gene_expression_plots",
                           save_plot = TRUE,
                           width = 8, height = 5, dpi = 300) {
  stopifnot(length(conds) == 2)
  sum_lab <- paste(conds, collapse = " + ")
  lev     <- c(sum_lab, conds)
  gk      <- to_key(gene)

  rows <- lapply(CELLS, function(cell) {
    N   <- NORM[[cell]]
    idx <- which(strip_ver(rownames(N$mat)) == gk)
    if (length(idx) == 0) return(NULL)
    idx <- idx[which.max(rowMeans(N$mat[idx, , drop = FALSE]))]
    v   <- N$mat[idx, ]
    per <- lapply(conds, function(cc) v[N$cd$Condition == cc])
    m   <- vapply(per, mean, numeric(1))

    d <- dge[[cell]][["CTR_vs_TIS"]]
    d <- d[d$key == strip_ver(rownames(N$mat)[idx]), , drop = FALSE]
    ann <- if (nrow(d) == 1 && !is.na(d$padj))
      sprintf("log2FC(TIS/CTR) = %.2f, padj = %.2g", d$log2FC, d$padj) else "DGE: not tested"
    facet <- paste0(toupper(cell), "\n", ann)

    data.frame(
      facet = facet,
      Bar   = factor(lev, levels = lev),
      mean  = c(sum(m), m)
    )
  })
  
  rows <- Filter(Negate(is.null), rows)
  if (length(rows) == 0) {
    warning("Gene not found in count matrix: ", gene)
    return(NULL)
  }
  bars <- dplyr::bind_rows(rows)

  p <- ggplot(bars, aes(Bar, mean, fill = Bar)) +
    geom_col(width = 0.7) +
    geom_text(aes(label = sprintf("%.0f", mean)), vjust = -0.6, size = 3.4) +
    facet_wrap(~ facet, scales = "free_y") +
    scale_fill_manual(values = setNames(c("grey55", "#4292C6", "#C0392B"), lev), guide = "none") +
    scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
    labs(
      x = NULL,
      y = "Normalized expression (DESeq2, mean)",
      title = gene,
      subtitle = sprintf("First bar: sum of average normalized counts for %s", sum_lab)
    ) +
    theme_minimal(base_size = 12) +
    theme(plot.title = element_text(face = "bold"), panel.grid.major.x = element_blank())

  # Automatikus mentés
  if (save_plot) {
    if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
    out_file <- file.path(out_dir, sprintf("gene_expr_%s.png", gene))
    ggsave(filename = out_file, plot = p, width = width, height = height, dpi = dpi, bg = "white")
    cat(sprintf("Mentve: %s\n", out_file))
  }

  return(p)
}

