                ref  = abs(conc$dPSI_ref),
                mean = (abs(conc$dPSI_ref) + abs(conc$dPSI_tgt)) / 2,
                min  = pmin(abs(conc$dPSI_ref), abs(conc$dPSI_tgt)),
                stop("Ismeretlen LABEL_BY: ", LABEL_BY))
lab_keys <- conc$key[order(score, decreasing = TRUE)][seq_len(min(N_LABEL, n_hc))]
cat("Címkézett gének:", paste(conc$Gene_Name[match(lab_keys, conc$key)], collapse = ", "), "\n")

cat(sprintf("High-confidence gének MCF7-ben: %d | T47D-ben is mérhető: %d | Pearson r = %.2f | Spearman rho = %.2f | azonos irány = %.1f%%\n",
