  dplyr::select(Event_ID, key, geneSymbol, EventType, FDR_ref = FDR, dPSI_ref = dPSI, JC_ref = Total_JC) %>%
  dplyr::inner_join(ev_tgt %>% dplyr::select(Event_ID, FDR_tgt = FDR, dPSI_tgt = dPSI, sig_tgt = sig, JC_tgt = Total_JC),
                    by = "Event_ID") %>%
  dplyr::arrange(FDR_ref, dplyr::desc(abs(dPSI_ref))) %>%
  dplyr::distinct(key, .keep_all = TRUE)

# --- 2. DESeq2 log2FC (TIS - CTR) + génnév ---
attach_lfc <- function(x, cell) {
  d <- dge[[cell]][[HC_CMP]]
  x %>% dplyr::mutate(log2FC    = d$log2FC[match(key, d$key)],
                      Gene_Name = dplyr::coalesce(unname(KEY2SYM[key]), geneSymbol)) %>%
    dplyr::filter(!is.na(log2FC))
}

best_sig <- function(ev) ev %>% dplyr::filter(sig) %>%
  dplyr::arrange(FDR, dplyr::desc(abs(dPSI))) %>% dplyr::distinct(key, .keep_all = TRUE)

# --- 3. high-confidence + illesztés ---
hc_keys <- get_das(REF_CELL, HC_CMP, HC_SOURCE)$sig

# log2FC mindkét sejtvonalból
lfc <- function(cell) { d <- dge[[cell]][[HC_CMP]]; setNames(d$log2FC, d$key) }
matched <- matched %>%
  dplyr::mutate(lfc_ref = unname(lfc(REF_CELL)[key]), lfc_tgt = unname(lfc(TGT_CELL)[key]),
                Gene_Name = dplyr::coalesce(unname(KEY2SYM[key]), geneSymbol)) %>%
  dplyr::filter(!is.na(lfc_ref), !is.na(lfc_tgt))

n_m   <- nrow(matched)
k_m   <- sum(sign(matched$dPSI_ref) == sign(matched$dPSI_tgt))
bt    <- binom.test(k_m, n_m, p = 0.5)
pct   <- 100 * k_m / n_m
r_p   <- cor(matched$dPSI_ref, matched$dPSI_tgt)
rho_s <- cor(matched$dPSI_ref, matched$dPSI_tgt, method = "spearman")

cat(sprintf(paste0("MCF7 szignifikáns high-confidence események: %d | illeszthető a T47D-ben (Event_ID): %d (%.1f%%)\n",
                   "Illesztett gének (DGE-vel is): %d | azonos irány: %d/%d = %.1f%% [95%% CI %.1f-%.1f], binomiális p = %.2g\n",
                   "Pearson r = %.2f | Spearman rho = %.2f\n"),
            nrow(ref_hc_ev),
            sum(ref_hc_ev$Event_ID %in% ev_tgt$Event_ID), 100 * mean(ref_hc_ev$Event_ID %in% ev_tgt$Event_ID),
            n_m, k_m, n_m, pct, 100 * bt$conf.int[1], 100 * bt$conf.int[2], bt$p.value, r_p, rho_s))
write.csv(matched, "high_confidence_event_matched_genes.csv", row.names = FALSE)

# --- 4. adatok a panelekhez ---
