## 6.11 Magas konfidenciájú TIS-asszociált splicing konkordancia (eseményillesztett, végleges ábra)

Ez a 6.8 ábra eseményillesztett változata. A három panel **ugyanazt a génhalmazt** mutatja:
az MCF7-ben rMATS ÉS LeafCutter által támogatott (konszenzus DAS) gének szignifikáns rMATS eseményei közül azok,
amelyek **ugyanazzal az `Event_ID`-val (típus + chr + szál + koordináták) a T47D rMATS eredményében is megtalálhatók**.
Génenként az az illeszthető esemény szerepel, amelynek az MCF7 FDR-je a legkisebb (a választás csak az MCF7 adatán alapul).

* 1. panel: MCF7 (szürke = az összes szignifikáns rMATS gén, színes = az illesztett high-confidence gének, szín = MCF7 dPSI).
* 2. panel: ugyanezek az események a T47D-ben (fekete = T47D szignifikáns rMATS háttér, a színes pontok megtartják az MCF7 dPSI színüket).
* 3. panel: MCF7 dPSI vs T47D dPSI ugyanarra az eseményre, statisztikával (azonos irány + egzakt 95% CI, Pearson, Spearman).

Önálló chunk: a 6.8–6.10 chunkok nélkül is lefut, csak a korábbi fejezetek objektumai kellenek
(`dge`, `get_das`, `to_key`, `KEY2SYM`, `RMATS_BASE_DIR`). A feliratok csak a top gének kapják, a pontok mind megmaradnak.

```{r hc_event_matched_figure, fig.width=17, fig.height=6.2}
suppressPackageStartupMessages(library(ggrepel))

# ====== ÁLLÍTSD BE ======
HC_CMP    <- "CTR_vs_TIS"
REF_CELL  <- "mcf7"
TGT_CELL  <- "t47d"
HC_SOURCE <- "consensus"                                        # rMATS ÉS LeafCutter az MCF7-ben
HC_FDR    <- get0("SIG_THRESHOLD",  ifnotfound = 0.05)
HC_DPSI   <- get0("DPSI_THRESHOLD", ifnotfound = 0.1)
MIN_REF   <- 0.1                                                # minimum MCF7 |dPSI| az illesztett eseményekre
EV_TYPES  <- c("SE", "RI", "MXE", "A5SS", "A3SS")
COL_LIM   <- 0.4                                                # színskála +-határa
N_LABEL   <- 12                                                 # Érdemes 12-re állítani (4-4-4 kategóriánként)
MIN_LABEL_JC <- 100                                             # ÚJ: Minimum átlagos junction count a szép sashimihez
# =========================

# --- 1. rMATS események Event_ID-val (dPSI = TIS - CTR = -IncLevelDifference) ---
read_rmats_events_id <- function(cell, cmp = HC_CMP) {
  dir <- file.path(RMATS_BASE_DIR, cell, cmp, "output")
  ev <- dplyr::bind_rows(lapply(EV_TYPES, function(et) {
    f <- file.path(dir, paste0(et, ".MATS.JC.txt"))
    if (!file.exists(f)) return(NULL)
    
    d <- read.delim(f, stringsAsFactors = FALSE, check.names = FALSE)
    if (nrow(d) == 0) return(NULL) # Biztonsági ellenőrzés üres fájlokra
    
    coord_cols <- grep("Start_0base$|End$|ES$|EE$", names(d), value = TRUE)
    pos <- do.call(paste, c(d[coord_cols], sep = "-"))
    
    # JAVÍTÁS: Biztonságos vapply és Helyes oszlopnevek (SAMPLE_1, SAMPLE_2)
    calc_mean_jc <- function(col) {
      if (is.null(col) || length(col) == 0) return(numeric(nrow(d)))
      vapply(strsplit(as.character(col), ","), function(x) mean(as.numeric(x), na.rm = TRUE), numeric(1))
    }
    
    tot_jc <- calc_mean_jc(d$IJC_SAMPLE_1) + calc_mean_jc(d$SJC_SAMPLE_1) + 
              calc_mean_jc(d$IJC_SAMPLE_2) + calc_mean_jc(d$SJC_SAMPLE_2)
              
    data.frame(Event_ID = paste(et, d$chr, d$strand, pos, sep = "_"), EventType = et,
               GeneID = d$GeneID, geneSymbol = d$geneSymbol,
               FDR = as.numeric(d$FDR), dPSI = -as.numeric(d$IncLevelDifference),
               Total_JC = tot_jc,
               stringsAsFactors = FALSE)
  }))
  
  if (nrow(ev) == 0) return(ev) # Ha egyáltalán nincs esemény
  
  ev %>%
    dplyr::mutate(key = to_key(GeneID),
                  sig = !is.na(FDR) & FDR < HC_FDR & abs(dPSI) > HC_DPSI) %>%
    dplyr::filter(!is.na(dPSI), !is.na(FDR), !is.na(key)) %>%
    dplyr::arrange(FDR, dplyr::desc(abs(dPSI))) %>%
    dplyr::distinct(Event_ID, .keep_all = TRUE)
}

# 1. Futtasd le az új, javított read_rmats_events_id függvényt

# 2. Hozd létre újra a táblákat, hogy belekerüljön a Total_JC oszlop:
