# rMATS: ha van Ensembl-ID oszlop, azt használjuk, különben a Gene_Name-et
rmats_keys <- function(d) {
  col <- intersect(c("GeneID", "gene_id", "Gene_ID"), names(d))[1]
  if (!is.na(col)) to_key(d[[col]]) else to_key(d$Gene_Name)
}

# LeafCutterben tesztelt gének (a p.adjust klaszter szintű, minden összehasonlításra közös)
leaf_tested_genes <- function(leaf_df) {
  leaf_df %>%
    dplyr::filter(!is.na(gene_name), !is.na(p.adjust)) %>%
    dplyr::pull(gene_name) %>%
    strsplit(",") %>% unlist() %>% stringr::str_trim() %>%
    setdiff(c("", "NA")) %>% unique() %>% to_key() %>% stats::na.omit() %>% unique()
}
rmats_tested_genes <- function(rm_list, cmps)
  unique(stats::na.omit(unlist(lapply(rm_list[cmps], rmats_keys))))

# egy sejtvonal + összehasonlítás-halmaz + definíció -> list(sig, tested)  (Ensembl ID kulcsokkal)
get_das <- function(cell, cmps, source = DAS_SOURCE) {
  S <- splice_in[[cell]]
  rm_t <- rmats_tested_genes(S$rm_all, cmps)
  lf_t <- leaf_tested_genes(S$lf_all)

  per_cmp <- function(cmp) {
    rm_s <- to_key(S$rm_sig[[cmp]]); lf_s <- to_key(S$lf_sig[[cmp]])
    switch(source,
           union      = union(rm_s, lf_s),
           consensus  = intersect(rm_s, lf_s),
           rmats      = rm_s,
           leafcutter = lf_s,
           stop("Ismeretlen DAS_SOURCE: ", source))
  }
  list(sig = stats::na.omit(unique(unlist(lapply(cmps, per_cmp)))),
       tested = switch(source, union = union(rm_t, lf_t), consensus = intersect(rm_t, lf_t),
                       rmats = rm_t, leafcutter = lf_t))
}

get_dge <- function(cell, cmps, def = DGE_DEF) {
  d <- dplyr::bind_rows(dge[[cell]][cmps])
  sig <- if (def == "padj") d$padj_sig else d$DGE_sig
  list(sig    = unique(d$key[sig]),
       minor  = if (def == "padj") character() else unique(d$key[d$padj_sig & !d$DGE_sig]),
       tested = unique(d$key[!is.na(d$padj)]))
}

