## 6.9 Konkordancia érzékenységvizsgálata

Az MCF7 → T47D konkordancia függ attól, hogy (i) mi számít high-confidence génnek, (ii) génenként melyik rMATS eseményt vesszük,
(iii) a T47D-ben bármelyik eseményt elfogadjuk-e, vagy csak a szignifikánsat, és (iv) mekkora MCF7 |dPSI| alatt dobjuk el a géneket.
**Az összes kombinációt** megmutatjuk (nem csak a legjobbat), egzakt binomiális teszttel az 50%-os véletlen ellen
(H0: az irány véletlenszerű), Clopper–Pearson 95%-os CI-vel és BH-korrekcióval a rácson belül.
Az elsődleges eredmény a 6.8 fejezet beállítása (`consensus`, `max_dpsi`, `any`, `min_ref = 0.1`); a többi csak a robusztusságot mutatja.

Az eseményt a 6.8-ban beolvasott `read_rmats_events()` adja, a `HC_*`, `REF_CELL`, `TGT_CELL` változókat is onnan használjuk.

```{r concordance_sensitivity, fig.width=11, fig.height=7}
ev_ref <- read_rmats_events(REF_CELL)
ev_tgt <- read_rmats_events(TGT_CELL)

# gén szintű dPSI; rule = "max_dpsi" (szignifikáns, legnagyobb |dPSI|) vagy "min_fdr" (szignifikáns, legkisebb FDR)
gl <- function(ev, rule) {
  x <- ev %>%
    dplyr::mutate(key = to_key(GeneID),
                  sig = !is.na(FDR) & FDR < HC_FDR & abs(dPSI) > HC_DPSI) %>%
    dplyr::filter(!is.na(key), !is.na(dPSI), !is.na(FDR)) %>%
    dplyr::group_by(key)
  x <- if (rule == "max_dpsi") dplyr::arrange(x, dplyr::desc(sig), dplyr::desc(abs(dPSI)), .by_group = TRUE)
       else                    dplyr::arrange(x, dplyr::desc(sig), FDR, dplyr::desc(abs(dPSI)), .by_group = TRUE)
  x %>% dplyr::slice(1) %>% dplyr::ungroup() %>% dplyr::select(key, dPSI, sig)
}

conc_stats <- function(source, rule, tgt_req, min_ref) {
  hc <- get_das(REF_CELL, HC_CMP, source)$sig
  r  <- gl(ev_ref, rule) %>% dplyr::filter(key %in% hc, abs(dPSI) >= min_ref)
  t  <- gl(ev_tgt, rule)
  if (tgt_req == "tgt_sig") t <- dplyr::filter(t, sig)
  j  <- dplyr::inner_join(dplyr::select(r, key, x = dPSI), dplyr::select(t, key, y = dPSI), by = "key")
  n  <- nrow(j)
  out <- data.frame(source = source, rule = rule, tgt_req = tgt_req, min_ref = min_ref, n_hc_ref = nrow(r),
                    n = n, k_same = NA_integer_, pct_same = NA_real_, ci_lo = NA_real_, ci_hi = NA_real_,
                    binom_p = NA_real_, pearson = NA_real_, spearman = NA_real_, stringsAsFactors = FALSE)
  if (n < 3) return(out)
  k  <- sum(sign(j$x) == sign(j$y))
  bt <- binom.test(k, n, p = 0.5)
  out$k_same <- k; out$pct_same <- 100 * k / n
  out$ci_lo <- 100 * bt$conf.int[1]; out$ci_hi <- 100 * bt$conf.int[2]; out$binom_p <- bt$p.value
  out$pearson  <- cor(j$x, j$y, method = "pearson")
  out$spearman <- cor(j$x, j$y, method = "spearman")
  out
}

