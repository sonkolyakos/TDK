## 6.3 Négy kategória és P(DGE | DAS)

```{r overlap_calc}
# gén szintű besorolás az univerzumon belül
overlap_genes_tbl <- function(cell, cmps, source = DAS_SOURCE, def = DGE_DEF) {
  das <- get_das(cell, cmps, source); dg <- get_dge(cell, cmps, def)
  universe <- intersect(das$tested, dg$tested)
  bm <- dge[[cell]][[1]]                                   # a baseMean minden összehasonlításban azonos
  data.frame(key = universe, stringsAsFactors = FALSE) %>%
    dplyr::mutate(
      Gene_Name = unname(KEY2SYM[key]),
      baseMean  = bm$baseMean[match(key, bm$key)],
      DGE = key %in% dg$sig,
      DAS = key %in% das$sig,
      DGE_minor = key %in% dg$minor & !DGE,                # padj < küszöb, de |LFC| a küszöb alatt
      Category = factor(dplyr::case_when(DGE & DAS ~ "DGE + DAS", DAS ~ "DAS only",
                                         DGE ~ "DGE only", TRUE ~ "Neither"), levels = DGE_CATS))
}

# baseMean-nal korrigált asszociáció: logisztikus regresszió + Cochran-Mantel-Haenszel
adj_stats <- function(g) {
  out <- c(OR_adj = NA_real_, OR_adj_p = NA_real_, CMH_OR = NA_real_, CMH_p = NA_real_)
  if (sum(g$DAS) < 5 || sum(g$DGE) < 5 || sum(!g$DAS) < 5 || sum(!g$DGE) < 5) return(out)
  g$lbm <- log10(g$baseMean + 1)
  m <- tryCatch(suppressWarnings(glm(DGE ~ DAS + lbm, data = g, family = binomial)), error = function(e) NULL)
  if (!is.null(m) && "DASTRUE" %in% rownames(coef(summary(m)))) {
    cf <- coef(summary(m))["DASTRUE", ]
    out[["OR_adj"]] <- exp(cf[["Estimate"]]); out[["OR_adj_p"]] <- cf[["Pr(>|z|)"]]
  }
  brk <- unique(quantile(g$lbm, probs = seq(0, 1, length.out = N_STRATA + 1), na.rm = TRUE))
  if (length(brk) >= 3) {
    st  <- cut(g$lbm, brk, include.lowest = TRUE)
    tab <- table(factor(g$DAS, c(FALSE, TRUE)), factor(g$DGE, c(FALSE, TRUE)), st)
    mh  <- tryCatch(mantelhaen.test(tab), error = function(e) NULL)
    if (!is.null(mh)) { out[["CMH_OR"]] <- unname(mh$estimate); out[["CMH_p"]] <- mh$p.value }
  }
  out
}

summarise_overlap <- function(g, cell, cmp, source, def) {
  n <- table(g$Category)[DGE_CATS]; n[is.na(n)] <- 0
  both <- n[[ "DGE + DAS" ]]; das_o <- n[[ "DAS only" ]]; dge_o <- n[[ "DGE only" ]]; nei <- n[[ "Neither" ]]
  ft <- tryCatch(fisher.test(matrix(c(both, das_o, dge_o, nei), 2, byrow = TRUE)), error = function(e) NULL)
  ad <- adj_stats(g)
  data.frame(
    Cell_Line = toupper(cell), Comparison = cmp, DAS_definition = source, DGE_definition = def,
    N_universe = nrow(g), N_DGE = both + dge_o, N_DAS = both + das_o,
    DGE_DAS = both, DAS_only = das_o, DGE_only = dge_o, Neither = nei,
    DAS_only_minorDGE = sum(g$DAS & !g$DGE & g$DGE_minor),     # DAS only gének, amelyekben padj szignifikáns, de kis LFC
    Neither_minorDGE  = sum(!g$DAS & !g$DGE & g$DGE_minor),
    P_DGE_given_DAS     = ifelse(both + das_o > 0, both / (both + das_o), NA_real_),
    P_DGE_given_notDAS  = ifelse(dge_o + nei > 0, dge_o / (dge_o + nei), NA_real_),   # P(DGE | nem DAS)
    P_DGE_background    = ifelse(nrow(g) > 0, (both + dge_o) / nrow(g), NA_real_),    # P(DGE) az univerzumban
    P_DAS_given_DGE     = ifelse(both + dge_o > 0, both / (both + dge_o), NA_real_),
    Odds_ratio          = if (!is.null(ft)) unname(ft$estimate) else NA_real_,
    Fisher_p            = if (!is.null(ft)) ft$p.value else NA_real_,
    OR_adj = ad[["OR_adj"]], OR_adj_p = ad[["OR_adj_p"]], CMH_OR = ad[["CMH_OR"]], CMH_p = ad[["CMH_p"]],
    stringsAsFactors = FALSE)
}

CMP_SETS <- c(as.list(COMPARISONS), list(COMPARISONS))        # 3 páros + "bármelyik" (kiegészítő)
CMP_NAMES <- c(COMPARISONS, "Any_comparison")

run_overlap <- function(source, def = DGE_DEF) {
  res <- list(); genes <- list()
  for (cell in CELLS) for (i in seq_along(CMP_SETS)) {
    g <- overlap_genes_tbl(cell, CMP_SETS[[i]], source, def)
    key <- paste(cell, CMP_NAMES[i], sep = "|")
    genes[[key]] <- dplyr::mutate(g, Cell_Line = toupper(cell), Comparison = CMP_NAMES[i])
    res[[key]]   <- summarise_overlap(g, cell, CMP_NAMES[i], source, def)
  }
  s <- dplyr::bind_rows(res)
  # többszörös tesztelés: BH az adott (DAS-, DGE-definíció) összes sorára
  s$Fisher_padj <- p.adjust(s$Fisher_p, "BH")
  s$OR_adj_padj <- p.adjust(s$OR_adj_p, "BH")
  s$CMH_padj    <- p.adjust(s$CMH_p, "BH")
  list(summary = s, genes = dplyr::bind_rows(genes))
}

