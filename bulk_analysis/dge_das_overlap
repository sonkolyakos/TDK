            toupper(REF_CELL), nrow(ev_ref_id), toupper(TGT_CELL), nrow(ev_tgt_id),
            length(intersect(ev_ref_id$Event_ID, ev_tgt_id$Event_ID))))

matched_stats <- function(source, tgt_req, min_ref, level) {
  hc <- get_das(REF_CELL, HC_CMP, source)$sig
  r  <- ev_ref_id %>%
    dplyr::filter(sig, key %in% hc, abs(dPSI) >= min_ref) %>%
    dplyr::select(Event_ID, key, FDR_r = FDR, x = dPSI)
  t  <- ev_tgt_id %>% dplyr::select(Event_ID, y = dPSI, sig_t = sig)
  j  <- dplyr::inner_join(r, t, by = "Event_ID")
  n_match_any <- nrow(j)
  if (tgt_req == "tgt_sig") j <- dplyr::filter(j, sig_t)
  if (level == "gene_best")
    j <- j %>% dplyr::arrange(FDR_r, dplyr::desc(abs(x))) %>% dplyr::distinct(key, .keep_all = TRUE)
  n <- nrow(j)
  out <- data.frame(source = source, tgt_req = tgt_req, min_ref = min_ref, level = level,
                    n_ref_events = nrow(r), n_matched_any = n_match_any,
                    match_pct = ifelse(nrow(r) > 0, 100 * n_match_any / nrow(r), NA_real_),
                    n = n, n_genes = dplyr::n_distinct(j$key), k_same = NA_integer_, pct_same = NA_real_,
                    ci_lo = NA_real_, ci_hi = NA_real_, binom_p = NA_real_,
                    pearson = NA_real_, spearman = NA_real_, stringsAsFactors = FALSE)
  if (n >= 3) {
    k  <- sum(sign(j$x) == sign(j$y)); bt <- binom.test(k, n, p = 0.5)
    out$k_same <- k; out$pct_same <- 100 * k / n
    out$ci_lo <- 100 * bt$conf.int[1]; out$ci_hi <- 100 * bt$conf.int[2]; out$binom_p <- bt$p.value
    out$pearson <- cor(j$x, j$y); out$spearman <- cor(j$x, j$y, method = "spearman")
  }
  list(stats = out, data = j)
}

