```{r}
library(dplyr)
library(tidyr)
library(ggplot2)
library(scales)

# ==============================================================================
# Automatikus 3-kondíciós (CTR, TIS, REPOP) Expression-Weighted Splice plot
# ==============================================================================
# ÚJ PARAMÉTER: force_event_id - Ha meg van adva, EZZEL szűrjük ki a rMATS sort
plot_expression_weighted_3cond <- function(gene, cell = "mcf7", 
                                           event_type = NULL, 
                                           event_id = NULL,
                                           force_event_id = NULL,
                                           out_dir = "expression_weighted_plots",
                                           save_plot = TRUE,
                                           width = 6.5, height = 6, dpi = 300) {
  
  cell <- tolower(cell)
  cell_upper <- toupper(cell)
  
  # 1. Expresszió kinyerése a NORM objektumból (CTR, TIS, REPOP)
  if (!cell %in% names(NORM)) stop("A megadott sejtvonal nincs a NORM objektumban: ", cell)
  N <- NORM[[cell]]
  gk <- to_key(gene)
  
  idx <- which(strip_ver(rownames(N$mat)) == gk)
  if (length(idx) == 0) stop("A gén nem található az expressziós mátrixban: ", gene)
  idx <- idx[which.max(rowMeans(N$mat[idx, , drop = FALSE]))]
  
  v <- N$mat[idx, ]
  expr_ctr   <- mean(v[N$cd$Condition == "CTR"], na.rm = TRUE)
  expr_tis   <- mean(v[N$cd$Condition == "TIS"], na.rm = TRUE)
  expr_repop <- mean(v[N$cd$Condition == "REPOP"], na.rm = TRUE)
  
  # 2. rMATS esemény azonosítása (CTR_vs_TIS futtatásból)
  rm_dir_tis <- file.path(RMATS_BASE_DIR, cell, "CTR_vs_TIS", "output")
  all_ev_types <- c("SE", "RI", "MXE", "A5SS", "A3SS")
  found_events <- list()
  
  for (ev in all_ev_types) {
    f <- file.path(rm_dir_tis, paste0(ev, ".MATS.JC.txt"))
    if (!file.exists(f)) next
    raw_df <- read.delim(f, header = TRUE, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
    match_rows <- raw_df[raw_df$geneSymbol == gene, ]
    if (nrow(match_rows) > 0) {
      match_rows$EventType <- ev
      coord_cols <- grep("Start_0base$|End$|ES$|EE$", names(match_rows), value = TRUE)
      pos_vec <- apply(match_rows[, coord_cols, drop = FALSE], 1, paste, collapse = "-")
      match_rows$Event_ID <- paste(ev, match_rows$chr, match_rows$strand, pos_vec, sep = "_")
      found_events[[ev]] <- match_rows
    }
  }
  
  if (length(found_events) == 0) return(NULL) # Hibakezelés barátságosabban
  ev_df <- dplyr::bind_rows(found_events)
  
  # KIVÁLASZTÁSI LOGIKA
  if (!is.null(force_event_id)) {
    # Ha kikényszerítünk egy ID-t (T47D eset), csak azt az egyet tartjuk meg
    ev_df <- ev_df[ev_df$Event_ID == force_event_id, ]
    if (nrow(ev_df) == 0) return(NULL)
    ev_top <- ev_df[1, ]
  } else {
    # Hagyományos szűrés (MCF7 eset)
    if (!is.null(event_id)) {
      ev_df <- ev_df[ev_df$Event_ID == event_id, ]
    } else if (!is.null(event_type)) {
      ev_df <- ev_df[ev_df$EventType == event_type, ]
    }
    if (nrow(ev_df) == 0) return(NULL)
    # A legszignifikánsabb CTR->TIS esemény kiválasztása
    ev_top <- ev_df %>% dplyr::arrange(FDR, dplyr::desc(abs(IncLevelDifference))) %>% dplyr::slice(1)
  }
  
  ev_type_chosen <- ev_top$EventType
  target_event_id <- ev_top$Event_ID
  fdr_tis        <- as.numeric(ev_top$FDR)
  dpsi_tis       <- -as.numeric(ev_top$IncLevelDifference) 
  
  # PSI: sample1 = CTR, sample2 = TIS
  psi_ctr <- mean(as.numeric(strsplit(as.character(ev_top$IncLevel1), ",")[[1]]), na.rm = TRUE)
  psi_tis <- mean(as.numeric(strsplit(as.character(ev_top$IncLevel2), ",")[[1]]), na.rm = TRUE)
  
  # 3. REPOP PSI kinyerése a CTR_vs_REPOP fájlból ugyanarra az eseményre
  rm_dir_repop <- file.path(RMATS_BASE_DIR, cell, "CTR_vs_REPOP", "output")
  f_repop <- file.path(rm_dir_repop, paste0(ev_type_chosen, ".MATS.JC.txt"))
  
  psi_repop <- NA_real_
  dpsi_repop <- NA_real_
  fdr_repop <- NA_real_
  
  if (file.exists(f_repop)) {
    raw_repop <- read.delim(f_repop, header = TRUE, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
    coord_cols <- grep("Start_0base$|End$|ES$|EE$", names(raw_repop), value = TRUE)
    pos_vec <- apply(raw_repop[, coord_cols, drop = FALSE], 1, paste, collapse = "-")
    raw_repop$Event_ID <- paste(ev_type_chosen, raw_repop$chr, raw_repop$strand, pos_vec, sep = "_")
    
    match_repop <- raw_repop[raw_repop$Event_ID == target_event_id, ]
    if (nrow(match_repop) > 0) {
      psi_repop  <- mean(as.numeric(strsplit(as.character(match_repop$IncLevel2[1]), ",")[[1]]), na.rm = TRUE)
      dpsi_repop <- -as.numeric(match_repop$IncLevelDifference[1])
      fdr_repop  <- as.numeric(match_repop$FDR[1])
    }
  }
  
  # 4. Adattábla felépítése a súlyozott adatokhoz
  df_plot <- data.frame(
    Condition = factor(c("CTR", "TIS", "REPOP"), levels = c("CTR", "TIS", "REPOP")),
    Mean_Expr = c(expr_ctr, expr_tis, expr_repop),
    PSI       = c(psi_ctr, psi_tis, psi_repop)
  ) %>%
    dplyr::mutate(
      Inclusion_weighted   = Mean_Expr * PSI,
      Alternative_weighted = Mean_Expr * (1 - PSI)
    )
  
  df_weighted <- df_plot %>%
    dplyr::select(Condition, Inclusion = Inclusion_weighted, Alternative = Alternative_weighted) %>%
    tidyr::pivot_longer(cols = c("Alternative", "Inclusion"), names_to = "Usage", values_to = "Counts") %>%
    dplyr::mutate(Usage = factor(Usage, levels = c("Alternative", "Inclusion")))
  
  splice_colors <- c("Inclusion" = "#D95F02", "Alternative" = "#1F78B4")
  
  # 5. Diagram elkészítése
  title_text <- sprintf("%s %s | %s", cell_upper, gene, ev_type_chosen)
  sub_text <- sprintf("Expression-weighted composition\nCTR\u2192TIS: \u0394PSI=%.3f (FDR=%.1e) | CTR\u2192REPOP: \u0394PSI=%.3f (FDR=%.1e)",
                      dpsi_tis, fdr_tis, dpsi_repop, fdr_repop)
  
  p_weighted <- ggplot(df_weighted, aes(x = Condition, y = Counts, fill = Usage)) +
    geom_col(position = "stack", width = 0.55, color = "grey30", linewidth = 0.2) +
    scale_fill_manual(values = splice_colors, labels = c("Alternative usage", "Inclusion usage")) +
    scale_y_continuous(expand = expansion(mult = c(0, 0.08)), labels = scales::comma) +
    labs(
      title = title_text,
      subtitle = sub_text,
      x = NULL, 
      y = "Mean normalized gene expression",
      fill = "Local splice usage"
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(face = "bold", size = 14),
      plot.subtitle = element_text(size = 10, color = "grey20", lineheight = 1.2),
      legend.position = "top",
      legend.justification = "left",
      legend.title = element_text(face = "bold", size = 10),
      axis.line = element_line(linewidth = 0.5),
      axis.ticks = element_line(linewidth = 0.5)
    )
  
  # 6. Mentés
  if (save_plot) {
    if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
    out_filename <- file.path(out_dir, sprintf("expr_weighted_3cond_%s_%s.png", cell, gene))
    ggsave(filename = out_filename, plot = p_weighted, width = width, height = height, dpi = dpi, bg = "white")
    cat(sprintf("Ábra sikeresen elmentve: %s\n", out_filename))
  }
  
  # Visszaadjuk a kiválasztott esemény azonosítóját is, hogy átadhassuk a másik sejtvonalnak!
  return(list(plot = p_weighted, event_id = target_event_id))
}

