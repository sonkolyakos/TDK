## 6.2 DAS halmazok és tesztelhető univerzum

A splicing eszközök génjeit (szimbólum vagy ID) egységesen Ensembl gén-ID-ra képezzük le (`to_key`).
Elsőként az Ensembl ID-t használjuk, ha van (pl. az rMATS `GeneID` oszlopa); szimbólumokat az `org.Hs.eg.db` (aktuális szimbólumok,
egyértelmű aliasok) és az `EnsDb.Hsapiens.v86` segítségével képezünk le. A le nem képezhető gének `SYM:<név>` kulcsot kapnak,
így nem kerülnek a DGE-vel közös univerzumba (az ilyenek arányát kiírjuk).

```{r das_sets}
build_sym_map <- function() {
  edb <- ensembldb::select(EnsDb.Hsapiens.v86, keys = ensembldb::keys(EnsDb.Hsapiens.v86, "GENEID"),
                           keytype = "GENEID", columns = c("GENEID", "SYMBOL"))
  tab <- data.frame(sym = edb$SYMBOL, ens = edb$GENEID, prio = 2L, stringsAsFactors = FALSE)
  if (requireNamespace("org.Hs.eg.db", quietly = TRUE)) {
    db <- org.Hs.eg.db::org.Hs.eg.db
    ek <- AnnotationDbi::keys(db, "ENTREZID")
    s  <- AnnotationDbi::select(db, keys = ek, keytype = "ENTREZID", columns = c("SYMBOL", "ENSEMBL"))
    a  <- AnnotationDbi::select(db, keys = ek, keytype = "ENTREZID", columns = c("ALIAS", "ENSEMBL"))
    a  <- unique(a[!is.na(a$ALIAS) & !is.na(a$ENSEMBL), c("ALIAS", "ENSEMBL")])
    a  <- a[!(a$ALIAS %in% a$ALIAS[duplicated(a$ALIAS)]), ]        # csak egyértelmű aliasok
    tab <- rbind(tab,
                 data.frame(sym = s$SYMBOL, ens = s$ENSEMBL, prio = 1L, stringsAsFactors = FALSE),
                 data.frame(sym = a$ALIAS,  ens = a$ENSEMBL, prio = 3L, stringsAsFactors = FALSE))
  } else {
    message("Figyelem: az org.Hs.eg.db nincs telepítve, csak az EnsDb v86 szimbólumai használhatók (elavult szimbólumok kimaradhatnak).")
  }
  tab <- tab[!is.na(tab$sym) & tab$sym != "" & !is.na(tab$ens), ]
  tab <- tab[order(tab$prio), ]
  tab$up <- toupper(tab$sym)
  tab <- tab[!duplicated(tab$up), ]
  setNames(tab$ens, tab$up)
}
SYM_MAP <- build_sym_map()

to_key <- function(x) {
  x0 <- strip_ver(x)
  out <- x0
  is_ens <- grepl("^ENSG[0-9]+$", x0)
  m <- unname(SYM_MAP[toupper(x0)])
  out[!is_ens] <- ifelse(is.na(m[!is_ens]), paste0("SYM:", x0[!is_ens]), m[!is_ens])
  out[is.na(x) | x0 %in% c("", "NA")] <- NA_character_
  out
}

