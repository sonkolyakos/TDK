## 6.8 Magas konfidenciájú TIS-asszociált splicing konkordancia

Az MCF7-ben **rMATS ÉS LeafCutter által egymástól függetlenül támogatott** (konszenzus DAS) géneket
"high-confidence" génekként kezeljük, majd megnézzük, hogy a T47D-ben ugyanezek a gének milyen irányban
és mekkora dPSI-vel splicingolódnak.

* 1. panel: MCF7 referencia (szürke = az összes szignifikáns rMATS gén, színes = high-confidence gének, szín = MCF7 dPSI).
* 2. panel: ugyanezek a gének a T47D-ben (fekete = T47D szignifikáns rMATS háttér, a színes gének megtartják az MCF7 dPSI színüket).
* 3. panel: MCF7 dPSI vs T47D dPSI a közös high-confidence génekre (Pearson, Spearman, azonos irányú gének aránya).

Gén szintű dPSI: génenként az a rMATS esemény, amely szignifikáns (FDR + |dPSI| küszöb), és közülük a legnagyobb |dPSI|-jű;
ha a T47D-ben nincs szignifikáns esemény, a legnagyobb |dPSI|-jű esemény szerepel (ilyenkor a pont nem a szignifikáns háttér része).
Előjel: dPSI = TIS − CTR, x tengely: DESeq2 (apeglm) log2FC, TIS vs CTR.

```{r hc_concordance, fig.width=17, fig.height=6}
suppressPackageStartupMessages(library(ggrepel))

# ====== ÁLLÍTSD BE ======
HC_CMP   <- "CTR_vs_TIS"
REF_CELL <- "mcf7"
TGT_CELL <- "t47d"
HC_FDR   <- get0("SIG_THRESHOLD",  ifnotfound = 0.05)   # ha a korábbi fejezetekben definiáltad, azt veszi
HC_DPSI  <- get0("DPSI_THRESHOLD", ifnotfound = 0.1)
EV_TYPES <- c("SE", "RI", "MXE", "A5SS", "A3SS")
COL_LIM  <- 0.4                                         # a színskála +-határa
N_LABEL  <- 12                                          # hány gén kapjon címkét (minden panelen ugyanaz a top N)
LABEL_BY <- "mean"   # "ref" = |MCF7 dPSI| szerint; "mean" = a két sejtvonal |dPSI| átlaga szerint; "min" = a kisebbik |dPSI| szerint
# =========================

# --- 1. rMATS események beolvasása (dPSI = TIS - CTR = -IncLevelDifference) ---
read_rmats_events <- function(cell, cmp = HC_CMP) {
  dir <- file.path(RMATS_BASE_DIR, cell, cmp, "output")
  dplyr::bind_rows(lapply(EV_TYPES, function(ev) {
    f <- file.path(dir, paste0(ev, ".MATS.JC.txt"))
    if (!file.exists(f)) return(NULL)
    d <- read.delim(f, stringsAsFactors = FALSE, check.names = FALSE)
    data.frame(EventType = ev, GeneID = d$GeneID, geneSymbol = d$geneSymbol,
               FDR = as.numeric(d$FDR), dPSI = -as.numeric(d$IncLevelDifference),
               stringsAsFactors = FALSE)
  }))
}

# --- 2. gén szintű összegzés (Ensembl kulccsal) ---
gene_level <- function(ev) {
  ev %>%
    dplyr::mutate(key = to_key(GeneID),
                  sig = !is.na(FDR) & FDR < HC_FDR & abs(dPSI) > HC_DPSI) %>%
    dplyr::filter(!is.na(key), !is.na(dPSI)) %>%
    dplyr::group_by(key) %>%
    dplyr::arrange(dplyr::desc(sig), dplyr::desc(abs(dPSI)), .by_group = TRUE) %>%
    dplyr::slice(1) %>%
    dplyr::ungroup() %>%
    dplyr::select(key, geneSymbol, EventType, FDR, dPSI, sig)
}

# --- 3. DESeq2 log2FC hozzárendelése (TIS - CTR) ---
attach_lfc <- function(g, cell) {
  d <- dge[[cell]][[HC_CMP]]
  g %>%
    dplyr::mutate(log2FC     = d$log2FC[match(key, d$key)],
                  Gene_Name  = dplyr::coalesce(unname(KEY2SYM[key]), geneSymbol)) %>%
    dplyr::filter(!is.na(log2FC))
}

ref_all <- attach_lfc(gene_level(read_rmats_events(REF_CELL)), REF_CELL)
tgt_all <- attach_lfc(gene_level(read_rmats_events(TGT_CELL)), TGT_CELL)

# --- 4. high-confidence gének: rMATS ÉS LeafCutter az MCF7-ben (konszenzus DAS) ---
hc_keys <- get_das(REF_CELL, HC_CMP, "consensus")$sig

ref_hc <- ref_all %>% dplyr::filter(key %in% hc_keys) %>%
  dplyr::mutate(dPSI_ref = dPSI)
tgt_hc <- tgt_all %>% dplyr::filter(key %in% ref_hc$key) %>%
  dplyr::mutate(dPSI_ref = ref_hc$dPSI_ref[match(key, ref_hc$key)])

ref_bg <- ref_all %>% dplyr::filter(sig, !key %in% ref_hc$key)
tgt_bg <- tgt_all %>% dplyr::filter(sig, !key %in% tgt_hc$key)

# közös gének a 3. panelhez
conc <- dplyr::inner_join(
  ref_hc %>% dplyr::select(key, Gene_Name, dPSI_ref),
  tgt_hc %>% dplyr::select(key, dPSI_tgt = dPSI), by = "key")

n_hc  <- nrow(conc)
r_p   <- cor(conc$dPSI_ref, conc$dPSI_tgt, method = "pearson")
rho_s <- cor(conc$dPSI_ref, conc$dPSI_tgt, method = "spearman")
same  <- 100 * mean(sign(conc$dPSI_ref) == sign(conc$dPSI_tgt))

# a címkézendő top gének (a pontok mind megmaradnak, csak a felirat korlátozott)
