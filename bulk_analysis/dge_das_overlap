venn_dge_das_prop <- function(cell) {
  g <- ov_genes %>% dplyr::filter(Cell_Line == toupper(cell), Comparison == VENN_CMP)

  n_dge_only <- sum(g$DGE & !g$DAS)
  n_das_only <- sum(!g$DGE & g$DAS)
  n_both     <- sum(g$DGE & g$DAS)

  fit <- euler(c("DGE" = n_dge_only, "DAS" = n_das_only, "DGE&DAS" = n_both))

  p <- plot(
    fit,
    quantities = list(cex = 1.0, font = 2, col = "black"),
    labels = list(cex = 1.1, font = 2, col = "black"),
    edges = list(col = c("DGE" = "#1F78B4", "DAS" = "#C0392B"), lwd = 3),
    fills = list(fill = c("DGE" = "#9ECAE1", "DAS" = "#FC9272"), alpha = 0.4),
    main = list(label = toupper(cell), cex = 1.3, font = 2)
  )

  # scale the finished eulerr plot to 90% so that the thick outline is not clipped
  p_scaled <- grobTree(p, vp = viewport(width = 0.9, height = 0.9))
  patchwork::wrap_elements(p_scaled)
}

