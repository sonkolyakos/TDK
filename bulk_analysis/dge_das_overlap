# 6. Figure 13: MCF7-referenced, event-matched concordance of high-confidence events

High-confidence genes are supported by both rMATS and LeafCutter in the reference cell line (consensus DAS). Their significant rMATS events are matched to the other cell line by `Event_ID` (type + chr + strand + coordinates). Per gene, the matched event with the lowest reference FDR is shown (the choice uses the reference data only). Panels: reference cell line, the same events in the other cell line, and dPSI vs dPSI. Colour = reference dPSI. Gene labels are chosen to cover DAS-only, DGE-only and DGE + DAS examples among events with sufficient junction coverage.

```{r hc_event_matched_mcf7_ref, fig.width=18, fig.height=6.5}
# ====== SET ======
HC_CMP    <- "CTR_vs_TIS"
REF_CELL  <- "mcf7"
TGT_CELL  <- "t47d"
HC_SOURCE <- "consensus"                                        # rMATS AND LeafCutter in the reference cell line
HC_FDR    <- get0("SIG_THRESHOLD",  ifnotfound = 0.05)
HC_DPSI   <- get0("DPSI_THRESHOLD", ifnotfound = 0.1)
MIN_REF   <- 0.1                                                # minimum reference |dPSI| of the matched events
EV_TYPES  <- c("SE", "RI", "MXE", "A5SS", "A3SS")
COL_LIM   <- 0.4                                                # +- limit of the colour scale
N_LABEL   <- 12                                                 # labelled genes (4 per category)
MIN_LABEL_JC <- 100                                             # minimum mean junction count of labelled events
# =================

# --- 1. rMATS events with Event_ID (dPSI = TIS - CTR = -IncLevelDifference) ---
read_rmats_events_id <- function(cell, cmp = HC_CMP) {
  dir <- file.path(RMATS_BASE_DIR, cell, cmp, "output")
  ev <- dplyr::bind_rows(lapply(EV_TYPES, function(et) {
    f <- file.path(dir, paste0(et, ".MATS.JC.txt"))
    if (!file.exists(f)) return(NULL)

    d <- read.delim(f, stringsAsFactors = FALSE, check.names = FALSE)
    if (nrow(d) == 0) return(NULL)

    coord_cols <- grep("Start_0base$|End$|ES$|EE$", names(d), value = TRUE)
    pos <- do.call(paste, c(d[coord_cols], sep = "-"))

    calc_mean_jc <- function(col) {
      if (is.null(col) || length(col) == 0) return(numeric(nrow(d)))
      vapply(strsplit(as.character(col), ","), function(x) mean(as.numeric(x), na.rm = TRUE), numeric(1))
    }

    tot_jc <- calc_mean_jc(d$IJC_SAMPLE_1) + calc_mean_jc(d$SJC_SAMPLE_1) +
              calc_mean_jc(d$IJC_SAMPLE_2) + calc_mean_jc(d$SJC_SAMPLE_2)

    data.frame(Event_ID = paste(et, d$chr, d$strand, pos, sep = "_"), EventType = et,
               GeneID = d$GeneID, geneSymbol = d$geneSymbol,
               FDR = as.numeric(d$FDR), dPSI = -as.numeric(d$IncLevelDifference),
               Total_JC = tot_jc,
               stringsAsFactors = FALSE)
  }))

  if (nrow(ev) == 0) return(ev)

  ev %>%
    dplyr::mutate(key = to_key(GeneID),
                  sig = !is.na(FDR) & FDR < HC_FDR & abs(dPSI) > HC_DPSI) %>%
    dplyr::filter(!is.na(dPSI), !is.na(FDR), !is.na(key)) %>%
    dplyr::arrange(FDR, dplyr::desc(abs(dPSI))) %>%
    dplyr::distinct(Event_ID, .keep_all = TRUE)
}

