## 6.1 DGE számítása (DESeq2)

Ugyanaz a módszer, mint a `gene_analysis_new.Rmd`-ben, sejtvonalanként megismételve:

* `design = ~ Condition`, minták a `Sample_id` alapján szűrve, a hibás minta kizárva,
* low-count szűrés: `rowSums(counts) >= ncol * 5`,
* két futtatás (CTR és REPOP referenciával), `lfcShrink(type = "apeglm")`,
* a `padj` a DESeq2 Wald-tesztjéből jön (az apeglm csak az LFC-t zsugorítja); a `results()` `alpha` paramétere a DGE-küszöbbel
  egyezik, így az independent filtering is erre a küszöbre optimalizál. A `|log2FC| > DGE_LFC` küszöb a zsugorított LFC-re vonatkozik.

Az irány a dPSI konvenciót követi (**log2FC = második − első kondíció**). A REPOP-referenciás futtatásban a
`CTR_vs_REPOP` és `TIS_vs_REPOP` együttható CTR − REPOP, illetve TIS − REPOP, ezért ezeknek az előjelét megfordítjuk.
A `padj = NA` gént (DESeq2 outlier / independent filtering) tesztelhetetlennek tekintjük, és kizárjuk az univerzumból.
Az eredménytáblák Ensembl ID-t (`key`, verziószám nélkül) és `baseMean`-t is tartalmaznak.

```{r dge_run}
COMPARISONS <- c("CTR_vs_TIS", "TIS_vs_REPOP", "CTR_vs_REPOP")

strip_ver <- function(x) sub("\\..*$", "", gsub('^"|"$', "", trimws(as.character(x))))

ens_to_symbol <- function(ids) {
  clean <- strip_ver(ids)
  map <- ensembldb::select(EnsDb.Hsapiens.v86, keys = unique(clean), keytype = "GENEID",
                           columns = c("GENEID", "SYMBOL"))
  map <- map[!duplicated(map$GENEID), ]
  sym <- map$SYMBOL[match(clean, map$GENEID)]
  ifelse(is.na(sym) | sym == "", ids, sym)           # ha nincs symbol, marad az ID
}

# minta-azonosító kulcs: SRR32118588 -> "SRR32118588"; ELTE-TTK-Onko-17_S139_L001 -> "Onko17"
sample_key <- function(x) {
  x    <- as.character(x)
  srr  <- stringr::str_extract(x, "SRR[0-9]+")
  onko <- stringr::str_match(x, "Onko[-_. ]?([0-9]+)")[, 2]
  ifelse(!is.na(srr), srr, ifelse(!is.na(onko), paste0("Onko", onko), NA_character_))
}

read_any <- function(f) {
  if (grepl("\\.csv$", f)) read.csv(f, stringsAsFactors = FALSE, check.names = FALSE)
  else read.delim(f, stringsAsFactors = FALSE, check.names = FALSE)
}

NORM <- list()   # normalizált count-ok a génenkénti ábrákhoz
VST  <- list()   # variancia-stabilizált értékek a QC-hez

run_dge_cell <- function(cell) {
  cfg <- CELL_CFG[[cell]]
  for (f in c(cfg$counts, cfg$meta)) if (!file.exists(f)) stop("Hiányzó fájl: ", f)

  # --- counts ---
  raw <- read.table(cfg$counts, header = TRUE, row.names = 1, stringsAsFactors = FALSE, check.names = FALSE)
  colnames(raw) <- gsub("\\.genes\\.results", "", colnames(raw))
  colnames(raw) <- gsub("-", ".", colnames(raw))
  colnames(raw) <- gsub("_$", "", colnames(raw))
  counts <- round(raw)
  ckey <- sample_key(colnames(counts))
  if (anyNA(ckey) || anyDuplicated(ckey))
    stop(cell, ": a count oszlopnevekből nem képezhető egyedi kulcs: ",
         paste(colnames(counts)[is.na(ckey) | duplicated(ckey)], collapse = ", "))

  # --- metadata ---
  md <- read_any(cfg$meta)
  if (!is.null(cfg$subset))
    md <- md[grepl(cfg$subset$pattern, md[[cfg$subset$col]], ignore.case = TRUE), , drop = FALSE]
  ids <- if (is.null(cfg$id_col)) md[[1]] else md[[cfg$id_col]]
  md$key <- sample_key(ids)
  cond <- toupper(trimws(as.character(md[[cfg$cond_col]])))
  hit  <- cond %in% names(COND_RECODE)
  cond[hit] <- COND_RECODE[cond[hit]]
  md$Condition <- cond
  excl <- sample_key(cfg$exclude)
  md <- md[!is.na(md$key) & md$Condition %in% COND_LEVELS & !(md$key %in% excl), , drop = FALSE]
  # kézzel megadott kondíciók azokra a count oszlopokra, amelyek nincsenek a metadatájában
  if (length(cfg$extra_cond) > 0) {
    if (anyNA(cfg$extra_cond)) stop(cell, ": töltsd ki az extra_cond kondícióit (jelenleg NA): ",
                                    paste(names(cfg$extra_cond)[is.na(cfg$extra_cond)], collapse = ", "))
    ex <- data.frame(key = names(cfg$extra_cond), Condition = toupper(unname(cfg$extra_cond)),
                     stringsAsFactors = FALSE)
    ex <- ex[!(ex$key %in% md$key), , drop = FALSE]
    md <- dplyr::bind_rows(md[, c("key", "Condition")], ex)
  }
  if (anyDuplicated(md$key)) stop(cell, ": duplikált minta kulcs a metadatájában: ",
                                  paste(md$key[duplicated(md$key)], collapse = ", "))

  # --- illesztés kulcs alapján ---
  common <- intersect(ckey, md$key)
  cat(sprintf("\n[%s] count minták: %d | metadata minták: %d | illesztve: %d\n",
              toupper(cell), length(ckey), nrow(md), length(common)))
  if (length(setdiff(md$key, ckey)) > 0)
    cat("  metadatában van, countban nincs:", paste(setdiff(md$key, ckey), collapse = ", "), "\n")
  if (length(setdiff(ckey, md$key)) > 0)
    cat("  countban van, metadatában nincs (kimarad):", paste(setdiff(ckey, md$key), collapse = ", "), "\n")

  counts <- counts[, match(common, ckey), drop = FALSE]
  cd <- data.frame(Condition = factor(md$Condition[match(common, md$key)], levels = COND_LEVELS),
                   row.names = colnames(counts))
  print(data.frame(count_oszlop = colnames(counts), Condition = cd$Condition), row.names = FALSE)
  print(table(cd$Condition))
  if (any(table(cd$Condition) < 2)) stop(cell, ": valamelyik kondícióban < 2 minta van")

  # --- DESeq2: CTR és REPOP referenciával, apeglm ---
  fit_ref <- function(ref) {
    d <- cd; d$Condition <- relevel(d$Condition, ref = ref)
    dds <- DESeqDataSetFromMatrix(countData = counts, colData = d, design = ~ Condition)
    dds <- dds[rowSums(counts(dds)) >= ncol(counts) * MIN_MEAN_COUNT, ]
    DESeq(dds, quiet = TRUE)
  }
  dds_ctr <- fit_ref("CTR")
  NORM[[cell]] <<- list(mat = sweep(as.matrix(counts), 2, sizeFactors(dds_ctr), "/"), cd = cd)
  VST[[cell]]  <<- tryCatch(vst(dds_ctr, blind = TRUE),
                            error = function(e) varianceStabilizingTransformation(dds_ctr, blind = TRUE))
  dds_repop <- fit_ref("REPOP")

  tidy_res <- function(dds, coef, sgn) {
    r0 <- results(dds, name = coef, alpha = DGE_PADJ)          # Wald-teszt, independent filtering alpha = DGE_PADJ
    r  <- as.data.frame(lfcShrink(dds, coef = coef, res = r0, type = "apeglm", quiet = TRUE))
    data.frame(Gene_ID = rownames(r), key = strip_ver(rownames(r)), baseMean = r$baseMean,
               log2FC = sgn * r$log2FoldChange, padj = r$padj, stringsAsFactors = FALSE)
  }
  res <- list(
    CTR_vs_TIS   = tidy_res(dds_ctr,   "Condition_TIS_vs_CTR",   +1),   # TIS - CTR
    TIS_vs_REPOP = tidy_res(dds_repop, "Condition_TIS_vs_REPOP", -1),   # REPOP - TIS
    CTR_vs_REPOP = tidy_res(dds_repop, "Condition_CTR_vs_REPOP", -1)    # REPOP - CTR
  )

  lapply(res[COMPARISONS], function(d) {
    d$Gene_Name <- ens_to_symbol(d$Gene_ID)
    d %>%
      dplyr::arrange(dplyr::desc(baseMean)) %>%
      dplyr::distinct(key, .keep_all = TRUE) %>%          # pl. PAR_Y duplikátumok: a magasabban expresszált marad
      dplyr::mutate(padj_sig = !is.na(padj) & padj < DGE_PADJ,
                    DGE_sig  = padj_sig & !is.na(log2FC) & abs(log2FC) > DGE_LFC)
  })
}

CELLS <- c("mcf7", "t47d")
dge <- setNames(lapply(CELLS, run_dge_cell), CELLS)

# Ensembl ID -> megjelenítendő génnév
KEY2SYM <- unlist(lapply(dge, function(x) setNames(x[[1]]$Gene_Name, x[[1]]$key)))
