cat("\nSignificant DGE genes (padj <", DGE_PADJ, ", |log2FC| >", DGE_LFC, "):\n")
print(sapply(dge, function(x) sapply(x, function(d) sum(d$DGE_sig))))
cat("\nUp / down in TIS vs CTR:\n")
print(sapply(dge, function(x) c(up   = sum(x$CTR_vs_TIS$DGE_sig & x$CTR_vs_TIS$log2FC > 0),
                                down = sum(x$CTR_vs_TIS$DGE_sig & x$CTR_vs_TIS$log2FC < 0))))
